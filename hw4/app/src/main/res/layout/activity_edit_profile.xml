<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/edit" android:textSize="26sp" />
        <ImageView android:id="@+id/avatar" android:layout_width="104dp" android:layout_height="104dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:src="@drawable/photo_2" android:scaleType="centerCrop" android:contentDescription="@string/avatar" />
        <Button android:id="@+id/btnAvatar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/pick_avatar" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/name" android:labelFor="@id/et_name" />
        <EditText android:id="@+id/et_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textPersonName" android:maxLines="1" android:hint="@string/name" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/student" android:labelFor="@id/et_student" />
        <EditText android:id="@+id/et_student" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="text" android:maxLines="1" android:hint="@string/student" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/phone" android:labelFor="@id/et_phone" />
        <EditText android:id="@+id/et_phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="phone" android:maxLines="1" android:hint="@string/phone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/email" android:labelFor="@id/et_email" />
        <EditText android:id="@+id/et_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textEmailAddress" android:maxLines="1" android:hint="@string/email" />
        <TextView android:id="@+id/genderLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/gender" android:textSize="18sp" />
        <RadioGroup android:id="@+id/genderGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/male" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/male" />
            <RadioButton android:id="@+id/female" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/female" />
        </RadioGroup>
        <TextView android:id="@+id/hobbiesLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hobbies" android:textSize="18sp" />
        <CheckBox android:id="@+id/travel" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/travel" />
        <CheckBox android:id="@+id/reading" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/reading" />
        <CheckBox android:id="@+id/gaming" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/gaming" />
        <CheckBox android:id="@+id/shopping" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/shopping" />
        <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/save" />
        <Button android:id="@+id/btnCancel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/cancel" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>